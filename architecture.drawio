        <mxCell id="UploadCSV" value="User CSV Upload - historical OHLC" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="extLayer"><mxGeometry x="60" y="180" width="220" height="40" as="geometry"/></mxCell>
        <mxCell id="Ingestor" value="Ingestor - ingestion.py - websocket threads parsing trade messages" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="ingestLayer"><mxGeometry x="360" y="120" width="220" height="60" as="geometry"/></mxCell>
        <mxCell id="WSClients" value="WebSocket Clients" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="ingestLayer"><mxGeometry x="360" y="190" width="220" height="40" as="geometry"/></mxCell>
        <mxCell id="SQLite" value="SQLite Database - ticks table and ohlc table - storage.py" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="storageLayer"><mxGeometry x="660" y="120" width="220" height="60" as="geometry"/></mxCell>
        <mxCell id="TickBuffer" value="Recent Tick Records" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="storageLayer"><mxGeometry x="660" y="190" width="220" height="40" as="geometry"/></mxCell>
        <mxCell id="OHLCTable" value="Uploaded OHLC Records" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="storageLayer"><mxGeometry x="660" y="240" width="220" height="40" as="geometry"/></mxCell>
