<mxfile host="app.diagrams.net">
  <diagram name="Page-1">
    <mxGraphModel>
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="extLayer" value="External Data Sources" style="swimlane=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="260" height="140" as="geometry"/></mxCell>
        <mxCell id="ingestLayer" value="Ingestion Layer" style="swimlane=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="340" y="80" width="260" height="140" as="geometry"/></mxCell>
